# --- Never commit copyrighted ROMs, patched ROMs, or save files ---
roms/
build/
*.gb
*.gbc
*.sav
*.sgm
*.state

# --- Large / re-downloadable tools (RGBDS, BGB, flips, mgbdis, etc.) ---
tools/

# --- External repos we depend on but don't own (re-clonable) ---
reference/

# --- Extracted game content (regenerable; treated like the ROM: used, never shipped) ---
# cards.json holds every card's English name and description, i.e. Darrman's
# translation text lifted out of the ROM. fusions.json is bulk table data.
# Regenerate with `python cardc.py extract [--product pN]` / `fusions.py extract`.
# Product data lives under work/<product>/ ; ignore the extracted files there.
work/*/cards.json
work/*/fusions.json
# Bulk WotC MTG source data (Project 2): raw LEB card stats + full flavor-text
# dump, scraped/regenerable. Same category as the ROM extract above — used, never
# shipped.
work/*/leb_cards_raw.json
work/*/mtg_flavor.json

# docs/DECKLISTS.md — a bulk dump of every opponent's decklist (most of the
# translated card names). Working file for manual pruning, regenerable. Local only.
docs/DECKLISTS.md

# --- Build artifacts ---
*.o
*.gbo
*.map
*.sym.tmp

# --- Python cache ---
__pycache__/
*.pyc

# --- OS / editor cruft ---
Thumbs.db
Desktop.ini
.DS_Store
.vscode/

# Recalc output — bulk translated names, regenerable working file
docs/RECALC.md
